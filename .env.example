# Project Atlas — environment template. Copy to .env (git-ignored) and fill in. Never commit .env.
#
# Market data for live paper trading (configs/paper_live.yaml): Alpaca market-data keys.
# Create them from an Alpaca *paper* trading account (paper accounts get their own keys).
# Atlas only reads prices from data.alpaca.markets (two GET endpoints). It contains no code
# that can place, change, or cancel an order at Alpaca or anywhere else; all orders and
# fills are simulated by Atlas's internal paper broker.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Live-order credentials must never be placed here. Live trading is out of scope until a
# separately approved Phase 8.
